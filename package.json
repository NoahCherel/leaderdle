{
  "name": "leaderdle",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/prerender-routes.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "shoot": "node scripts/shoot.mjs",
    "typecheck": "tsc --noEmit",
    "e2e:build": "playwright test -c playwright.build.config.ts",
    "serve": "node scripts/static-server.mjs",
    "data:fetch": "node scripts/leaders/fetch.mjs",
    "data:leaders": "node scripts/leaders/build.ts",
    "data:schedule": "node scripts/schedule/build.ts",
    "check:data": "node scripts/check-data.ts",
    "prebuild": "node scripts/check-data.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/fredoka": "^5.3.0",
    "flag-icons": "^7.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "wouter": "^3.13.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^31.0.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.6",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.7"
  }
}
